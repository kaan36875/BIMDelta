<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build for one Revit version at a time:
         dotnet build -c Release -p:RevitVersion=2027
       Revit 2024 runs .NET Framework 4.8, 2025 and 2026 run .NET 8, 2027 runs .NET 10. -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2027</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>BIMDelta.Revit</AssemblyName>
    <RootNamespace>BIMDelta.Revit</RootNamespace>
    <Version>0.6.0</Version>
    <OutputPath>bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies only: Revit provides the real ones at run time. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Compiled against an old WebView2 and not copied: Revit ships a newer one and has it
         loaded already. Where it is missing, the viewer opens in the default browser. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1823.32" ExcludeAssets="runtime;native;build;buildTransitive" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BIMDelta.Revit.Core\BIMDelta.Revit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
    <None Include="..\BIMDelta.addin" CopyToOutputDirectory="PreserveNewest" Link="BIMDelta.addin" />
  </ItemGroup>

</Project>
