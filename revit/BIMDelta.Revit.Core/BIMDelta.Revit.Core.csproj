<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything the add-in does that does not need Revit: Git, the bimdelta CLI, file layout.
       Kept separate so it can be unit tested without a Revit installation. -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>BIMDelta.Revit.Core</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
